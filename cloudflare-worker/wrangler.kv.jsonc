{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tg-forward-hub-worker",
  "main": "_worker.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 300000
  },
  "routes": [
    {
      "pattern": "tgzf.cite.us.ci",
      "zone_name": "cite.us.ci",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "triggers": {
    "crons": []
  },

  "containers": [
    {
      "class_name": "BotContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./container/Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_CONTAINER",
        "class_name": "BotContainer"
      }
    ]
  },
  "exports": {
    "BotContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  // KV mode. Replace id with the ID from `wrangler kv namespace create`.
  "kv_namespaces": [
    {
      "binding": "WHITELIST_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],

  "vars": {
    "ADMIN_ID": "6297561544",
    "WEB_ADMIN_USER": "admin",
    "STORAGE_BACKEND": "auto",
    "MAX_RANGE_MESSAGES": "10000",
    "CONTAINER_INACTIVITY_MS": "3600000",
    "CONTAINER_INSTANCE_ID": "singleton-v8"
  }
}
